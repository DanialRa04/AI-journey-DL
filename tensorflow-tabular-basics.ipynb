   "source": [
    "\n",
    "heart = pd.read_csv(DATA_DIR / 'heart.csv')\n",
    "heart['sex_label'] = heart['sex'].map({0: 'female', 1: 'male'})\n",
    "heart['target_label'] = heart['target'].map({0: 'no disease', 1: 'disease'})\n",
    "heart['cp_label'] = heart['cp'].map({0: 'typical', 1: 'atypical', 2: 'non-anginal', 3: 'asymptomatic'})\n",
    "\n",
    "print('Heart dataset shape:', heart.shape)\n",
    "print('Average age by target:')\n",
    "display(heart.groupby('target_label')['age'].mean().round(1).to_frame('avg_age'))\n"
   ]
  },
